theorem weightTable_verified :
    ∀ u : Fin 17, ∀ v : Fin 17,
      weights u.val v.val = (((weightTable.getD u.val []).getD v.val []) : Multiset ℕ) := by
  decide

def tableCapacity (u v d : ℕ) : ℕ :=
  ∑ k ∈ Icc 1 (max u v), min d
    (((((weightTable.getD u []).getD v []) : Multiset ℕ)).filter (fun w => k ≤ w)).card

/-- Only the quotients are bounded; the target layer may have any size d. -/
theorem capacity_eq_table (u v d : ℕ) (hu : u < 17) (hv : v < 17) :
    capacity u v d = tableCapacity u v d := by
  rw [capacity_from_weights, weightTable_verified ⟨u,hu⟩ ⟨v,hv⟩]
  rfl

#print axioms weightTable_verified
#print axioms capacity_eq_table

end RatioAggregateCapacity
