import research.RatioAggregateCapacity

/- A reusable kernel-checked table of candidate weight multisets. -/
set_option maxHeartbeats 0
set_option maxRecDepth 1000000

namespace RatioAggregateCapacity

open Finset

def weights (u v : ℕ) : Multiset ℕ := (ratioCandidates u v).val.map (ratioWeight u v)

lemma capacity_from_weights (u v d : ℕ) :
    capacity u v d =
      ∑ k ∈ Icc 1 (max u v), min d ((weights u v).filter (fun w => k ≤ w)).card := by
  unfold capacity weights
  apply sum_congr rfl
  intro k hk
  rw [Multiset.filter_map, Multiset.card_map]
  rfl

