private theorem append_filter_checked {α : Type*} (a b c d : List α) (p : α → Bool)
    (ha : a.filter p = c) (hb : b.filter p = d) :
    (a ++ b).filter p = c ++ d := by
  rw [List.filter_append, ha, hb]

