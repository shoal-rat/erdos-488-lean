/-- Complete finite table for minimal slack failures at excess 15. -/
theorem minimal_failure_mem_profilesFifteen (G : Finset Nat) (n : Nat)
    (hpos : ∀ g ∈ G, 2 ≤ g) (hprim : Primitive G)
    (hn : ∀ g ∈ G, g ≤ n) (hE : multipleCount G n = G.card + 15)
    (hfail : 2 * multipleCount G n < incidenceCount G n + G.card)
    (hmin : ∀ g ∈ G, quotientExcess G n ≤ 2 * 15 + (n / g - 1)) :
    quotientProfile G n ∈ minimalProfilesFifteen := by
  have hmin' : ∀ g ∈ G, quotientExcess G n ≤
      2 * (multipleCount G n - G.card) + (n / g - 1) := by
    intro g hg
    have he : multipleCount G n - G.card = 15 := by omega
    rw [he]
    exact hmin g hg
  rw [← minimalProfilesFifteen_checked]
  apply List.mem_filter.mpr
  refine ⟨?_, actual_aggregateTests G n 15 hpos hprim hn hE⟩
  rw [← preScreenFifteen_checked]
  apply List.mem_filter.mpr
  refine ⟨failure_mem_profilesFifteen G n hpos hprim hn hE hfail, ?_⟩
  simp only [Bool.and_eq_true]
  exact ⟨⟨⟨⟨⟨actual_higherGeometricTests G n 15 hpos hprim hn hE,
    actual_newCoreTests G n 15 hpos hprim hn hE⟩,
    DyadicCapacity.actual_dyadicTest G n 15 hpos hprim hn hE⟩,
    actual_fourteenCoreTests G n 15 hpos hprim hn hE⟩,
    actual_fourteenMoreTests G n 15 hpos hprim hn hE⟩,
    actual_minimalWeightTest G n 15 hE hmin'⟩

#print axioms minimal_failure_mem_profilesFifteen
end ExcessProfiles
