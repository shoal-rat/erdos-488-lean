def profileLE : List ℕ → List ℕ → Bool
  | [], _ => true
  | _ :: _, [] => false
  | a :: as, b :: bs => if a = b then profileLE as bs else decide (a ≤ b)

/- Structural fuel avoids reducing well-founded recursion inside a closed
kernel computation. The permutation theorem holds for every fuel value. -/
def mergeFuel : ℕ → List (List ℕ) → List (List ℕ) → List (List ℕ)
  | 0, xs, ys => xs ++ ys
  | _ + 1, [], ys => ys
  | _ + 1, xs, [] => xs
  | n + 1, x :: xs, y :: ys =>
      if profileLE x y then x :: mergeFuel n xs (y :: ys)
      else y :: mergeFuel n (x :: xs) ys

theorem mergeFuel_perm (n : ℕ) (xs ys : List (List ℕ)) :
    (mergeFuel n xs ys).Perm (xs ++ ys) := by
  induction n generalizing xs ys with
  | zero => exact List.Perm.refl _
  | succ n ih =>
    cases xs with
    | nil => simp [mergeFuel]
    | cons x xs =>
      cases ys with
      | nil => simp [mergeFuel]
      | cons y ys =>
        simp only [mergeFuel]
        split
        · exact (ih xs (y :: ys)).cons x
        · exact ((ih (x :: xs) ys).cons y).trans
            ((List.Perm.swap x y _).trans (List.perm_middle.symm.cons x))

def sortFuel : ℕ → List (List ℕ) → List (List ℕ)
  | 0, xs => xs
  | n + 1, xs =>
      if xs.length ≤ 1 then xs else
      let a := sortFuel n (xs.take (xs.length / 2))
      let b := sortFuel n (xs.drop (xs.length / 2))
      mergeFuel (a.length + b.length) a b

theorem sortFuel_perm (n : ℕ) (xs : List (List ℕ)) :
    (sortFuel n xs).Perm xs := by
  induction n generalizing xs with
  | zero => exact List.Perm.refl _
  | succ n ih =>
    simp only [sortFuel]
    split
    · exact List.Perm.refl _
    · exact (mergeFuel_perm _ _ _).trans
        (by simpa only [List.take_append_drop] using
          (ih (xs.take (xs.length / 2))).append (ih (xs.drop (xs.length / 2))))
#print axioms sortFuel_perm

theorem ordered_sorted : sortFuel 10 orderedProfiles = sortedProfiles := by
  decide +kernel
#print axioms ordered_sorted

theorem frozen_sorted : sortFuel 10 profiles = sortedProfiles := by
  decide +kernel
#print axioms frozen_sorted

theorem ordered_perm : orderedProfiles.Perm profiles := by
  have h₁ := sortFuel_perm 10 orderedProfiles
  have h₂ := sortFuel_perm 10 profiles
  rw [ordered_sorted] at h₁
  rw [frozen_sorted] at h₂
  exact h₁.symm.trans h₂
#print axioms ordered_perm
